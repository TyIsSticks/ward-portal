# Copy to .env and adjust. All values are optional.

# Display name used for the calendar and page titles
WARD_NAME=My Ward

# Set to true when served over HTTPS (e.g. through Tailscale Funnel)
COOKIE_SECURE=true

# Timezone used for the calendar
TZ=America/Denver

# GroupMe bots (set up in the app) post in this timezone. Set to false to stop all posting.
GROUPME_ENABLED=true
